# JOURNEY · keep a memory cell: wire an SR latch, capture it, and mark q as an output at the Foundry.
# A latch hears its own q, so §9.2 calls q internal; the export is what gives the blueprint an output pin.

clear
include scenes/start-with-a-stake.play
run /foundry
absent ─ Foundry

include scenes/grow-a-matrixtank.play
include scenes/buy-at-the-bench.play "Inverter Coil" Fabric
include scenes/buy-at-the-bench.play "Inverter Coil" Fabric
include scenes/buy-at-the-bench.play "Blank Circuit Blueprint" Materials
include scenes/take-a-fish.play botfish q
include scenes/take-a-fish.play botfish qn
run /consume inverter coil
key enter
key down
key enter
run /program "Q"
type r, qn
key down
type q
key enter
run /program "Qn"
type s, q
key down
type qn
key enter
absent listens

run /consume blank circuit blueprint
expect Name your
type latch
key enter
absent Name your

run /foundry
expect ─ Foundry
expect Fabricator
snap the latch reads two inputs and no output
type x
expect ENTER save
type q
snap typing q into exports
key enter
snap q is an output pin now
key tab
expect TAB list
key up 20
expect r, s → q
key down 20
snap the preview scrolled down to the schematic
key tab
expect TAB preview
key esc
absent ─ Foundry

run /inventory
# a new game starts with no items, so the blueprint is the inventory's first row.
expect Latch (Circuit
snap the blueprint is kept in the inventory
key esc
