# JOURNEY · type a line into a circuit: a Cochlea latches it and clocks it out, one character per strobe.
# The ear clocks itself: a coil rings on clk until done rises, and done holds the coil's input high.

clear
include scenes/start-with-a-stake.play
include scenes/grow-a-matrixtank.play
include scenes/buy-at-the-bench.play "Inverter Coil" Fabric
include scenes/buy-at-the-bench.play Cochlea Peripherals
include scenes/take-a-fish.play botfish ear

run /consume inverter coil
key enter
run /consume cochlea
expect Cochlea to the botfishes
snap the install picker offers the Cochlea to the botfish
key enter
absent to the botfishes

run /program "Ear"
type clk, fin
key down
type clk
key down
expect char[8]
type kbd
key down
type clk
key down 2
type fin
snap the ear wired to clock itself until it is done
key enter
absent listens

run /circuit
expect strobe ◂ clk
expect done ▸ fin
snap the circuit reads the four wires back
key esc
absent Circuit#

run hi
tick 20
run /circuit
expect ○  Ear
tick 1
expect ○  Ear
snap the line is read to its end and the clock has stopped for good
tick 1
expect ○  Ear
key esc
absent Circuit#
