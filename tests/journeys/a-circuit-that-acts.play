# JOURNEY · a circuit that does something: a clock fires a Command Module that feeds the tank.
# This is the whole Phase 3 promise in four fish-steps: part, wire, fire pin, script line.

clear
include scenes/start-with-a-stake.play
include scenes/grow-a-matrixtank.play
include scenes/buy-at-the-bench.play "Inverter Coil" Fabric
include scenes/buy-at-the-bench.play "Command Module" Hands
run /shop
key enter
select Food
key enter
expect < 1 >
key right 31
expect < 90 >
snap ninety food on the counter, thirty at a time past thirty
key enter
key esc
key esc
absent Price/unit
expect food
expect 150
include scenes/take-a-fish.play botfish clk
include scenes/take-a-fish.play botfish feeder

run /consume inverter coil
key enter
run /consume command module
key down
key enter

run /program "Clk"
type clk
key down
type clk
key enter

run /program "Feeder"
expect fire[1]
key down 2
type clk
key down 2
type /feed
snap the fire pin and the script line
key enter

tick 120
absent food: 150
absent food 150
snap the module spent food from the supply on its own
run /circuit
expect fire ◂ clk
snap the circuit shows the fire pin wired to the clock
key esc
